/// The contract between Horizon and its mods (docs/mods.md).
///
/// A mod is a WebAssembly component targeting the `mod` world. Each imported
/// interface but `log` is a capability: the mod's manifest lists the ones it
/// uses, the player sees them before turning the mod on, and the game refuses
/// a component that imports one its manifest does not declare.
package horizon:mods@0.1.0;

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    /// One line in the game's log as `[mod <id>] message`, at that level.
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player, the world clock and the block
/// the player looks at.
interface game {
    record player {
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
        /// 0 to 20, as the hunger bar.
        food: u32,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    /// None on the title screen.
    get-clock: func() -> option<clock>;
    /// A block along the player's view.
    record hit {
        /// The block hit.
        block-x: s32,
        block-y: s32,
        block-z: s32,
        /// The point on its face where the view meets it.
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:stone`, ...
        block: string,
    }
    /// The first block along the player's view (fluids pass), up to
    /// `distance` blocks (at most 1024; past the loaded chunks, across the
    /// distant terrain when LOD Distance is on), as of this tick. None when
    /// nothing is hit, and on the title screen.
    raycast: func(distance: f32) -> option<hit>;
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: string);
}

/// Capability `hud`: one panel of text lines per mod, drawn by the game
/// every frame until the mod changes or clears it (no call per frame).
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        /// Plain text, up to 256 characters.
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    /// Replaces the mod's panel: up to 16 lines in that corner of the screen.
    set-panel: func(corner: corner, lines: list<line>);
    /// Removes the mod's panel.
    clear: func();
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd
/// (docs/mods.md). Keys are `[a-z0-9_.-]{1,64}`, one path segment.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
    /// A setting the player can edit: `horizon-mods/config/<mod id>.toml`,
    /// made on first run from the manifest's `[config]` table, which also
    /// fills what the file leaves out. Read when the mod starts: `/hmod
    /// reload` reads it again. None for a key in neither.
    config: func(key: string) -> option<string>;
    /// A file of the mod's own package: `data/<mod id>/machines.json`, the
    /// data a NeoForge mod loads with a reload listener. Only under `assets/`
    /// or `data/`, in a mod with capability `registries`. None when absent.
    read-resource: func(path: string) -> option<list<u8>>;
}

/// Capability `command`: vanilla commands run as the player, with the
/// player's permissions, after the hook call returns (8 per call). A mod's
/// own commands are not run this way.
interface command {
    /// `line` without its slash; its feedback goes to the chat as if typed.
    run: func(line: string);
    /// `lines` (each without its slash, at most 256 a call) as `run` does,
    /// but with nothing in the chat: no feedback and no failure. In single
    /// player and on Horizon's servers, each runs exactly as the player
    /// typing it would (the same rights), in order, 64 a tick, and the
    /// server logs one line a batch; one that carries a chat message (`say`,
    /// `msg`) is refused. On any other server they go as chat commands, and
    /// there their feedback shows: a mod running many should say so.
    run-quiet: func(lines: list<string>);
}

/// Capability `ui`: widgets the game draws with its own menus' widgets, for
/// a screen the mod owns and a settings page in Options > Mods. Layout and
/// drawing are the game's: a mod says what its widgets hold, never where
/// they sit or how they look, and the game clips everything it is handed.
interface ui {
    /// A line of text.
    record text-widget {
        /// The mod's own name for the widget; `ui-events` calls echo it.
        id: u32,
        /// Up to 256 characters.
        text: string,
        /// 0xRRGGBB; 0 is the menus' white.
        color: u32,
    }
    /// An item's icon and a name beside it, as recipe viewers show them.
    record item-widget {
        /// The mod's own name for the widget.
        id: u32,
        /// `minecraft:diamond`, `<mod>:<path>`; an unknown id draws a "?".
        item: string,
        /// The name shown beside the icon (empty: the item's own).
        name: string,
    }
    /// Rows the player picks one of, as an options page lists choices: a
    /// pick is `ui-events::select`, `selected` is the row to mark now.
    record list-widget {
        /// The mod's own name for the widget; `ui-events::select` echoes it.
        id: u32,
        /// The rows' texts, at most 512, each up to 256 characters.
        rows: list<string>,
        /// The row to mark as the current choice, if any.
        selected: option<u32>,
    }
    /// A thing on a mod's screen or settings page.
    /// A button as the options pages have them (200 × 20): a click is
    /// `ui-events::select(id, 0)`. Mods cycle its label for a choice
    /// ("Corner: Top Left").
    record button-widget {
        /// The mod's own name for the widget.
        id: u32,
        /// Up to 256 characters.
        label: string,
    }
    variant widget {
        /// Text the player reads.
        text(text-widget),
        /// A button.
        button(button-widget),
        /// An item's icon and name.
        item(item-widget),
        /// Rows the player picks from.
        %list(list-widget),
    }
    /// A screen the mod owns: a title over widgets stacked down the middle,
    /// the Done button the game adds, and Esc to leave it.
    record screen {
        /// Its title, up to 256 characters.
        title: string,
        /// Its widgets, in order, at most 64.
        widgets: list<widget>,
    }
    /// Show `screen` over the game; a second call while it is open replaces
    /// it. Only the last call of one hook counts.
    open-screen: func(screen: screen);
    /// Close the mod's screen when it is open (the mod hears no `closed`
    /// for this: it was its own doing).
    close-screen: func();
    /// The mod's page in Options > Mods, reached from a settings button on
    /// its row: the widgets it shows, an empty list for no page. The player
    /// opening the page is `ui-events::settings-opened`: push fresh widgets
    /// then; later calls update the page while it shows.
    set-settings: func(widgets: list<widget>);
    /// Show the mod's own screen in place of a vanilla one: from now on,
    /// when the player would open `vanilla` (`minecraft:inventory`: the
    /// inventory key, in survival and creative alike), the game opens
    /// `replacement` as the mod's screen instead, not drawn over it. While it
    /// shows, `open-screen` updates it and leaving it is `ui-events::closed`
    /// as for any of the mod's screens; a later call replaces it, and
    /// none gives the vanilla screen back. The first mod (in load order)
    /// that replaces a screen gets it. Err for a screen this Horizon can't
    /// replace.
    replace-screen: func(vanilla: string, replacement: option<screen>) -> result<_, string>;
}

/// What the game calls on a mod that shows widgets (capability `ui`):
/// what the player did with them.
interface ui-events {
    /// A row of one of the mod's `list` widgets was picked: the widget's
    /// `id` and the row, on the screen or the settings page that showed it.
    select: func(id: u32, row: u32);
    /// The player left the mod's screen (Esc or Done); not for a screen the
    /// mod closed itself or one that went away with the mod.
    closed: func();
    /// The player opened the mod's settings page in Options > Mods: call
    /// `ui::set-settings` now to fill it with fresh widgets.
    settings-opened: func();
}

/// Capability `input` (experimental: the manifest needs
/// `experimental = ["input"]`): the use button on items the mod claims, and
/// the mod's own keys. Events wait for `poll`, at most 256.
interface input {
    /// The main hand's stack.
    record held-item {
        /// `minecraft:spyglass`, `<mod>:<path>`.
        id: string,
        count: u32,
        /// The hotbar slot, 0 to 8.
        slot: u32,
    }
    record item-use {
        item: held-item,
        /// Game ticks the button was held (0 on `use-start`).
        ticks: u32,
    }
    variant event {
        /// The use button went down with a claimed item in the main hand.
        /// The game does nothing else with the click: no placing, no eating,
        /// no swing.
        use-start(item-use),
        /// It came up again, or the item left the hand, or a screen opened.
        use-stop(item-use),
        /// A key `register-key` named went down or up while playing (no
        /// screen open). The game's own mapping on that key still runs. A
        /// screen opening lets every held key up.
        key-down(string),
        key-up(string),
        /// Mouse wheel steps while the mod holds the wheel (`claim-wheel`):
        /// positive away from the player, as the hotbar reads them.
        wheel(f32),
    }
    /// The items whose use the mod handles instead of the game, by id (at
    /// most 64). Replaces the previous list.
    claim-items: func(ids: list<string>);
    /// A key of the mod's: `name` comes back in `key-down` and `key-up`,
    /// `label` says what it does, `key` is the key as options.txt writes
    /// it (`key.keyboard.r`), the default: the player can bind another
    /// one on the mod's page in Options > Mods, and that one wins. At most
    /// 16; an unknown key is an error.
    register-key: func(name: string, label: string, key: string) -> result<_, string>;
    /// The main hand's stack, as of this tick; none when it is empty.
    held: func() -> option<held-item>;
    /// The events since the last call, oldest first.
    poll: func() -> list<event>;
    /// Takes the mouse wheel while playing (true) or gives it back: while
    /// taken, its steps are the mod's `wheel` events and the hotbar doesn't
    /// move. The game gives it back when the mod stops.
    claim-wheel: func(on: bool);
    /// A mapping as the player has bound it.
    record mapping-state {
        /// The bound key's name as Controls shows it: `W`, `Space`, `LMB`.
        label: string,
        /// Held down now (as of this frame for a mod with a `frame` hook,
        /// else this tick).
        down: bool,
    }
    /// A movement or click mapping as the player has bound it: `key.forward`,
    /// `key.left`, `key.back`, `key.right`, `key.jump`, `key.sneak`,
    /// `key.sprint`, `key.attack` or `key.use`. None for another name.
    mapping: func(name: string) -> option<mapping-state>;
    /// Clicks of the attack and use buttons in the last second.
    clicks-per-second: func() -> tuple<u32, u32>;
}

/// Capability `render` (experimental: the manifest needs
/// `experimental = ["render"]`): shapes the game draws for the mod with its
/// own renderer, kept until the mod replaces them (no call per frame). A mod
/// never supplies shader code.
interface render {
    /// A corner of the screen, as `hud`'s panels use them.
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    /// A rectangle in GUI pixels: the top left corner and the size.
    record rect {
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }
    /// A point in GUI pixels from the screen's top left.
    record point {
        x: f32,
        y: f32,
    }
    record fill-shape {
        rect: rect,
        /// 0xAARRGGBB.
        color: u32,
    }
    /// Any four-cornered shape (a wheel's segment, an arrow): the corners
    /// in order round it.
    record quad-shape {
        corners: tuple<point, point, point, point>,
        /// 0xAARRGGBB.
        color: u32,
    }
    record sprite-shape {
        /// One of the game's GUI sprites, as `gui/sprites/` names them
        /// (`hud/heart/full`, `widget/button`), the resource packs' versions
        /// included. An unknown one draws nothing.
        sprite: string,
        rect: rect,
        /// A tint, 0xAARRGGBB: 0xFFFFFFFF draws it as it is.
        color: u32,
    }
    record item-shape {
        /// `minecraft:diamond`, `<mod>:<path>`; an unknown one draws nothing.
        item: string,
        /// The icon's top left.
        at: point,
        /// 1.0 is the hotbar's 16 × 16.
        scale: f32,
    }
    record text-shape {
        /// Up to 256 characters, one line.
        text: string,
        at: point,
        /// 0xRRGGBB, as `hud`'s lines.
        color: u32,
        /// Centred on `at.x` instead of starting there.
        centered: bool,
        shadow: bool,
    }
    variant shape {
        fill(fill-shape),
        quad(quad-shape),
        sprite(sprite-shape),
        item(item-shape),
        text(text-shape),
    }
    /// One part of a placed model, moved from where the file puts it.
    record part-pose {
        /// As in the model's `parts`.
        part: string,
        /// Pixels added to its position.
        x: f32,
        y: f32,
        z: f32,
        /// Degrees added to its rotation.
        pitch: f32,
        yaw: f32,
        roll: f32,
    }
    /// A model of `data/<mod>/horizon/model/<name>.json` standing in the world.
    record placed-model {
        /// `<mod>:<name>`; an unknown one draws nothing.
        model: string,
        dimension: string,
        x: f64,
        y: f64,
        z: f64,
        /// Degrees.
        yaw: f32,
        pitch: f32,
        roll: f32,
        /// Degrees of yaw a second, turned smoothly by the game.
        spin: f32,
        /// 1.0 is the model's own size.
        scale: f32,
        /// Its parts' poses now; a part's `spin` in the file turns by itself.
        parts: list<part-pose>,
    }
    /// Replaces the models the mod has in the world, up to 1024: drawn every
    /// frame until replaced, the way a block entity renderer draws a machine's
    /// moving parts. An empty list removes them.
    set-models: func(models: list<placed-model>);
    /// How the windows titled `title` look: real menus (`storages.open-menu`),
    /// their slots, cursor and shift-clicks all the server's, laid out by the mod.
    record menu-layout {
        title: string,
        /// The window's size in GUI pixels.
        width: f32,
        height: f32,
        /// Where each of the storage's slots goes, in order; one not listed is hidden.
        slots: list<point>,
        /// The top left of the player's inventory, the hotbar 58 below it.
        inventory: point,
        /// Drawn under the slots, from the window's top left.
        shapes: list<shape>,
    }
    /// Replaces the mod's window layouts.
    set-menu-layouts: func(layouts: list<menu-layout>);
    /// A place on a canvas that hears clicks: `ui-events::select(id, 0)`.
    record canvas-area {
        id: u32,
        rect: rect,
    }
    /// Opens or updates a screen drawn entirely by the mod (it needs capability
    /// `ui` too): `shapes` in GUI pixels, up to 1024, in any layout, a machine's
    /// slots and gauges among them. It leaves as `ui.open-screen`'s does.
    open-canvas: func(title: string, shapes: list<shape>, areas: list<canvas-area>);
    /// Replaces the mod's HUD shapes: up to 1024, drawn every frame in
    /// order over the HUD (after the hotbar, under chat and screens), hidden
    /// with the HUD (F1). An empty list removes them.
    set-hud: func(shapes: list<shape>);
    /// The screen's size in GUI pixels (width, height), as of this tick.
    gui-size: func() -> tuple<f32, f32>;
    /// Shakes the camera: a jolt of `strength` (0 to 1, 1 the hardest) that
    /// fades out over `seconds` (at most 10). Jolts add up to 1. The view
    /// turns, the player doesn't, and the player's Distortion Effects option
    /// scales it (0 turns it off).
    shake: func(strength: f32, seconds: f32);
    /// Replaces the mod's corner panel: shapes in GUI pixels from the top
    /// left of a `width` × `height` box that the game places in `corner`,
    /// stacked with the game's overlays and the other mods' panels (under
    /// the status effects at the top right), as `hud`'s panels are.
    set-corner: func(corner: corner, width: f32, height: f32, shapes: list<shape>);
    /// Removes the mod's corner panel.
    clear-corner: func();
    /// The width of one line of text in GUI pixels, in the HUD's font: exact
    /// for Latin letters (U+0000 to U+024F), 6 per other character.
    text-width: func(text: string) -> f32;
    record frame-rate {
        /// Frames drawn in the last second.
        fps: u32,
        /// The slowest frame's rate, and the 1% low (the 99th percentile
        /// frame time's rate), over the last 5 seconds.
        min: u32,
        low: u32,
    }
    /// The game's frame counter, recomputed twice a second.
    frame-stats: func() -> frame-rate;
    record zoom {
        /// The field of view is divided by it: 1 is none, at most 10.
        factor: f32,
        /// Ease in and out through the game's field-of-view easing, as the
        /// spyglass does, instead of at once.
        smooth: bool,
        /// Mouse turning is multiplied by it while zoomed: 1 keeps the
        /// player's sensitivity, at least 0.05.
        turn: f32,
    }
    /// Zooms the camera until the next call (`factor` 1 ends it), only
    /// while playing: a screen opening or the spyglass's own view (which
    /// wins) leave the camera vanilla's. With several mods, the strongest
    /// zoom counts.
    set-zoom: func(zoom: zoom);
    record minimap {
        corner: corner,
        /// Its side in GUI pixels, 16 to 256.
        size: f32,
        /// World blocks per map pixel, 0.5 to 4; the map is 128 × 128 pixels.
        blocks-per-pixel: f32,
        /// The map turns with the player, who faces up, and an N on its rim
        /// marks north. Otherwise north is up and the player's arrow turns.
        rotate: bool,
        /// Round, the corners left clear; otherwise square.
        round: bool,
    }
    /// Shows a map of the world around the player in `corner`, stacked with
    /// the game's overlays and the mods' panels, until the next call (none
    /// hides it). It looks like a map item: vanilla's map colours with their
    /// height shading and water depth, and the player's arrow. Underground,
    /// under a roof and in the Nether it maps the floor around the player's
    /// height. The game keeps the map's tiles and refreshes them within its
    /// own frame budget; hidden, they are dropped. One map shows at a time:
    /// the first loaded mod's.
    set-minimap: func(minimap: option<minimap>);
    record far-terrain {
        /// How far the distant terrain reaches, in chunks: 64 to 1024. On
        /// integrated graphics other than Apple's the game caps it lower.
        distance: u32,
        /// Coarser far tiles, as the Far Detail setting's Reduced: 2 to 4 ms
        /// less GPU time per frame on integrated graphics.
        reduced: bool,
    }
    /// Draws the world beyond the render distance as distant terrain, out to
    /// `distance` chunks, until the next call (none ends it). The game builds
    /// it on its own workers, from the chunks already loaded or saved and,
    /// where nobody has been, from the world's generator; the simulation
    /// distance doesn't change. Only worlds whose generator the game has
    /// (single player and a LAN world you host) show it. The player's own LOD
    /// Distance setting, when on, wins. One far terrain shows at a time: the
    /// first loaded mod's.
    set-far-terrain: func(far-terrain: option<far-terrain>);
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    record registration {
        /// Chat commands, without the slash. A name vanilla already uses is
        /// refused (vanilla's command runs).
        commands: list<string>,
        /// Call `tick` every game tick (20 per second while playing).
        tick: bool,
        /// Call `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// Call `chat` for each chat line the player receives.
        chat: bool,
    }
    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    /// Each game tick while in a world, with the game's tick counter.
    tick: func(tick: u64);
    /// Each rendered frame, with the seconds since the last one.
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    /// Each chat line the player receives, as plain text.
    chat: func(text: string);
}

/// Capability `recipes` (experimental): the recipes and items the game
/// knows, for recipe viewers. In single player and on Horizon's servers
/// they are the world's; on any other server they are vanilla 26.3's (a
/// client is sent no others), while `known` follows that server's book.
interface recipes {
    /// An item of `items`, by its index there, with a count and the
    /// components it has beyond the item's own, in vanilla's item syntax
    /// (`[potion_contents={potion:"minecraft:swiftness"}]`), or "".
    record stack {
        item: u32,
        count: u32,
        components: string,
    }
    /// The station a recipe is made at.
    enum kind {
        crafting-shaped,
        crafting-shapeless,
        smelting,
        blasting,
        smoking,
        campfire,
        stonecutting,
        smithing,
        brewing,
    }
    record recipe {
        /// `minecraft:oak_planks`.
        id: string,
        kind: kind,
        /// The recipe book's tab (`crafting_building_blocks`,
        /// `furnace_food`), or "".
        category: string,
        /// Recipes the book shows on one button share a group, or "".
        group: string,
        /// A shaped recipe's grid: `slots` holds its cells row by row.
        /// 0 for the other kinds.
        width: u32,
        height: u32,
        /// Each slot's stacks, any one of which fits; an empty list is an
        /// empty cell. Cooking and stonecutting: the input. Smithing: the
        /// template, the base, the addition. Brewing: the bottle, the
        /// reagent.
        slots: list<list<stack>>,
        /// What it makes; several when that varies (a trim on any armour).
        results: list<stack>,
        /// Cooking: game ticks and experience; 0 for the other kinds.
        cooking-time: u32,
        experience: f32,
        /// The recipe book's id for it (one per way the book shows it), as
        /// `known` lists them; -1 for the kinds the book doesn't show
        /// (campfire, stonecutting, smithing, brewing).
        book-id: s32,
    }
    record item {
        /// `minecraft:diamond`, `<mod>:<path>`.
        id: string,
        /// In the player's language.
        name: string,
        /// Its item tags, without the `#`.
        tags: list<string>,
    }
    /// Every item, in the registry's order: `stack.item` indexes this list.
    items: func() -> list<item>;
    /// Every recipe: the book's in its order, then campfire, stonecutting,
    /// smithing and brewing. They don't change while a world is open.
    all: func() -> list<recipe>;
    /// The `book-id`s of the recipes the player's recipe book holds now.
    known: func() -> list<s32>;
    /// Places a recipe in the open screen's grid as a click in the recipe
    /// book does (`ServerboundPlaceRecipePacket`): the inventory's grid or
    /// a crafting table. `all` places as many as the items allow, as with
    /// Shift. Refused while no such screen is open, for a recipe the
    /// player's book doesn't hold and for one that can't be placed; one
    /// missing items shows as a ghost in the grid, as in the book.
    place: func(book-id: s32, all: bool) -> result<_, string>;
    /// Creative mode only: gives the player the stack, as taking it from
    /// the creative inventory does (`ServerboundSetCreativeModeSlot`): the
    /// selected slot first, then the hotbar, then the inventory. The count
    /// is cut to one stack of the item (64, 16 or 1).
    give: func(stack: stack) -> result<_, string>;
}

/// Capability `ui` (experimental): a recipe viewer's panel beside the
/// game's inventory and container screens (not the creative inventory), on
/// the right of the screen. The game draws it with its own widgets and
/// slots, pages it and keeps its search box; the mod says what it holds.
/// The first loaded mod with a panel shows.
interface browser {
    /// An item to show: its id, a count (1 draws none) and its components
    /// beyond the item's own, in vanilla's item syntax, or "".
    record stack {
        item: string,
        count: u32,
        components: string,
    }
    /// A click on an item of the panel, by its index in `set-items`'s list.
    record click {
        index: u32,
        right: bool,
    }
    /// A key the mod registered (`input.register-key`) went down while the
    /// pointer was on an item: a slot of the screen's, or the panel's.
    record item-key {
        key: string,
        stack: stack,
    }
    /// A click on a slot of a recipe the panel shows (`set-recipes`).
    record slot-click {
        /// The recipe's index in `set-recipes`'s list and the slot's in
        /// it; the results come after the slots.
        recipe: u32,
        slot: u32,
        /// The stack the slot showed at that moment.
        stack: stack,
        right: bool,
    }
    variant event {
        clicked(click),
        /// The search box's text, each time the player changes it.
        search(string),
        key(item-key),
        slot-clicked(slot-click),
        /// The action button of the recipe at this index in
        /// `set-recipes`'s list.
        action(u32),
        /// The player turned the recipes' page (`set-recipes`): the index
        /// of the first recipe now shown.
        page(u32),
        /// The back button of `set-recipes`.
        back,
        /// The player picked the tab at this index of `set-recipes`' tabs.
        tab(u32),
    }
    /// How the game lays out a recipe of `set-recipes`.
    enum layout {
        /// A crafting grid of `width` x `height` slots, an arrow and the
        /// result.
        grid,
        /// One input over a flame, an arrow and the result (furnaces,
        /// smokers, campfires).
        cooking,
        /// One input, an arrow and the result (the stonecutter).
        single,
        /// Template, base and addition, an arrow and the result.
        smithing,
        /// A potion and an ingredient, an arrow and the result.
        brewing,
    }
    /// A recipe to show. Each slot, and the result, cycles through its
    /// stacks, one a second; an empty slot shows nothing.
    record recipe-view {
        layout: layout,
        /// The grid's size (`grid` only), at most 3 x 3.
        width: u32,
        height: u32,
        slots: list<list<stack>>,
        results: list<stack>,
        /// A short line under the recipe (a cooking time), or "".
        note: string,
        /// The action button beside it: none, enabled, or shown greyed.
        action: option<bool>,
    }
    /// The panel's items, at most 8192 (an empty list hides the panel).
    set-items: func(items: list<stack>);
    /// Shows these recipes in the panel instead of its items, as many as
    /// fit a page, under `title` and a back button, with a row of `tabs`
    /// (each an icon; `tab` is the selected one) between them; an empty
    /// list of recipes shows the items again. At most 256 recipes and 16
    /// tabs.
    set-recipes: func(title: string, tabs: list<stack>, tab: u32, recipes: list<recipe-view>);
    /// What the player did on the panel since the last poll, at most 256
    /// kept.
    poll: func() -> list<event>;
}

/// Capability `players`, server mods only (manifest `api = "0.3"`,
/// experimental): the players on the server, and messages to them.
interface players {
    enum game-mode {
        survival,
        creative,
        adventure,
        spectator,
    }
    record player {
        /// The player's UUID, `xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx`.
        id: string,
        name: string,
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
        game-mode: game-mode,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
    }
    /// How a stack looks, beyond its item.
    record item-look {
        /// Its name, as an anvil's: none keeps what it has.
        name: option<string>,
        /// Lines under its name.
        lore: list<string>,
        /// The item model it shows: `mymod:press_tier_2`.
        model: option<string>,
        /// Forces the enchanted shine on or off.
        glint: option<bool>,
    }
    /// The same stack with this look, seen by every client.
    style-stack: func(stack: item-stack, look: item-look) -> result<item-stack, string>;
    /// While on, a blow that would kill this player leaves them on 1 health,
    /// as a totem does with no totem used and no effects. Until the world closes.
    set-undying: func(player: string, on: bool) -> result<_, string>;
    /// Whether a player is holding sneak, as of the tick's start.
    sneaking: func(player: string) -> bool;
    /// Where the player looks: yaw and pitch in degrees, as F3 shows them.
    look: func(player: string) -> option<tuple<f32, f32>>;
    /// The mod's bytes on a player under `key`, as `set-data` left them:
    /// saved with the world, kept through death and leaving (NeoForge's data
    /// attachments). Each mod sees only its own.
    get-data: func(player: string, key: string) -> option<list<u8>>;
    /// Keeps up to 65536 bytes on a player, up to 64 keys per mod and player.
    /// Empty `data` removes the key.
    set-data: func(player: string, key: string, data: list<u8>) -> result<_, string>;
    /// What happened to players since the last tick, for a mod's `tick`.
    record player-event {
        player: string,
        /// `died`, `respawned`, `changed-dimension` (detail: the new one),
        /// `crafted` (detail: the recipe), `tossed`, `used-item`, `broke-item`
        /// (detail: the item) or `targeted` (detail: the mob's id). With no
        /// player, `block-gone` (detail: `dimension x y z`): a storage's block
        /// went, however it did. New kinds may appear: ignore others.
        kind: string,
        detail: string,
    }
    /// This tick's player events. Asking twice in a tick gives them twice.
    poll-events: func() -> list<player-event>;
    /// An item stack, as server mods hand it around (inventories, block
    /// storages, item events).
    record item-stack {
        /// `minecraft:iron_ingot`.
        item: string,
        count: u32,
        /// The mod's own bytes on the stack (up to 1024), kept in the item's
        /// `minecraft:custom_data` and saved with it: every mod sees only its
        /// own. Stacks with different bytes do not stack together.
        data: list<u8>,
        /// Everything else the stack carries (enchantments, damage, a name,
        /// other mods' bytes), opaque: hand it back unchanged when moving the
        /// stack; empty for a plain new stack.
        components: list<u8>,
    }
    /// The players online, in the order they joined.
    online: func() -> list<player>;
    /// A system message to one player, after the mod's name; false when no
    /// player with that id is online. Up to 8 messages per call.
    tell: func(player: string, text: string) -> bool;
    /// A system message to every player and the server's log, after the
    /// mod's name. Counts toward the same 8 per call.
    broadcast: func(text: string);
    /// The player's inventory as of this tick's start, 41 slots: 0-8 the
    /// hotbar, 9-35 the main inventory, 36-39 armor (feet, legs, chest,
    /// head), 40 the off hand. Empty when no such player is online.
    inventory: func(player: string) -> list<option<item-stack>>;
    /// The hotbar slot the player holds (0-8); none when not online.
    selected-slot: func(player: string) -> option<u32>;
    /// Gives a stack as `/give` does: into the inventory, the rest dropped
    /// at the player's feet. Changes to inventories are made in order at the
    /// tick's end. Err for an unknown item or a player not online.
    give: func(player: string, stack: item-stack) -> result<_, string>;
    /// Puts a stack in a slot (`inventory`'s numbering), none empties it.
    set-slot: func(player: string, slot: u32, stack: option<item-stack>) -> result<_, string>;
    /// Takes up to `count` of `item` (any bytes and components) from the
    /// inventory, as `/clear` does: how many it holds of it now, so how many
    /// go at the tick's end.
    take: func(player: string, item: string, count: u32) -> u32;

    /// The online player with this name.
    by-name: func(name: string) -> option<player>;
    /// The online player with this id.
    by-id: func(id: string) -> option<player>;
    /// Whether a player with this id is online.
    is-online: func(id: string) -> bool;
    /// How many players are online.
    count: func() -> u32;
    /// The players in a dimension within `radius` blocks, nearest first.
    near: func(dimension: string, x: f64, y: f64, z: f64, radius: f64) -> list<player>;
    /// What the player holds in the main hand, as of the tick's start.
    held-item: func(player: string) -> option<item-stack>;
    /// What the player holds in the off hand, as of the tick's start.
    offhand-item: func(player: string) -> option<item-stack>;
    /// What the player wears: feet, legs, chest, head. Empty when not online.
    armor: func(player: string) -> list<option<item-stack>>;
    /// How many of `item` the whole inventory holds.
    count-item: func(player: string, item: string) -> u32;
    /// Whether the inventory holds at least `count` of `item`.
    has-item: func(player: string, item: string, count: u32) -> bool;
    /// Empty slots in the hotbar and main inventory.
    free-slots: func(player: string) -> u32;
    /// The first slot (`inventory`'s numbering) holding `item`.
    find-item: func(player: string, item: string) -> option<u32>;
    /// `/gamemode`.
    set-game-mode: func(player: string, mode: game-mode) -> result<_, string>;
    /// `/clear`: empties the whole inventory.
    clear-inventory: func(player: string) -> result<_, string>;
    /// `/title`: a big line on the player's screen, and a smaller one under it.
    show-title: func(player: string, title: string, subtitle: option<string>) -> result<_, string>;
    /// `/title actionbar`: a line over the hotbar.
    action-bar: func(player: string, text: string) -> result<_, string>;
    /// `/title times`: fade in, stay and fade out, in ticks.
    set-title-times: func(player: string, fade-in: u32, stay: u32, fade-out: u32) -> result<_, string>;
    /// `/experience add`: experience points; negative takes them away.
    add-experience: func(player: string, points: s32) -> result<_, string>;
    /// `/experience add`: whole levels; negative takes them away.
    add-levels: func(player: string, levels: s32) -> result<_, string>;
    /// `/spawnpoint`: where the player respawns.
    set-spawn: func(player: string, dimension: string, x: s32, y: s32, z: s32) -> result<_, string>;
    /// `/kick`. Single player's owner can't be kicked, as in vanilla.
    kick: func(player: string, reason: string) -> result<_, string>;
    /// `/playsound`: a sound only this player hears, where they stand.
    play-sound: func(player: string, sound: string, volume: f32, pitch: f32) -> result<_, string>;
    /// `/stopsound`: stops every sound this player hears.
    stop-sounds: func(player: string) -> result<_, string>;
    /// `/advancement grant ... only`.
    grant-advancement: func(player: string, advancement: string) -> result<_, string>;
    /// `/advancement revoke ... only`.
    revoke-advancement: func(player: string, advancement: string) -> result<_, string>;
    /// `/recipe give`: puts a recipe (`minecraft:oak_planks`) in the
    /// player's recipe book. Err for a recipe the book can't hold.
    unlock-recipe: func(player: string, recipe: string) -> result<_, string>;
    /// `/recipe take`: takes it out again.
    lock-recipe: func(player: string, recipe: string) -> result<_, string>;
}

/// Capability `world`, server mods only (manifest `api = "0.3"`,
/// experimental): the blocks of the server's loaded chunks, and changes to
/// them through the server's own block updates.
interface %world {
    record block-change {
        x: s32,
        y: s32,
        z: s32,
        /// `minecraft:oak_log[axis=y]`; properties left out take the block's
        /// defaults, `minecraft:stone` alone is the default state.
        state: string,
    }
    /// The block state at a position in a dimension (`minecraft:overworld`,
    /// ...), as `minecraft:oak_log[axis=y]`, as of this call: none where the
    /// server has no chunk loaded there.
    get-block: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// The biome at a position (`minecraft:plains`, ...), as the server
    /// stores it (one per 4 x 4 x 4 cell): none where no chunk is loaded.
    get-biome: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// Sets blocks as `/setblock` does: the old block entity removed,
    /// neighbours and shapes updated, light, and every player told. Every
    /// state is checked now (an error queues nothing); the changes are made
    /// in order after this call returns, before that dimension's next tick;
    /// one in a chunk not loaded then is skipped. At most 4096 per call.
    set-blocks: func(dimension: string, blocks: list<block-change>) -> result<_, string>;
    /// The mod's own bytes on the block at a position, as `set-data` left
    /// them: none when it kept none there, where no chunk is loaded, or when
    /// the block is no longer the one they were set on (broken or replaced
    /// since; its properties may change, a furnace lit or not). Only this
    /// mod's data: every mod has its own.
    get-data: func(dimension: string, x: s32, y: s32, z: s32) -> option<list<u8>>;
    /// Keeps `data` (up to 4096 bytes) on the block at a position: saved
    /// with the world, gone once that block is broken or replaced. Empty
    /// `data` removes it. Err where no chunk is loaded, on air, for too much,
    /// or past 65536 positions per mod.
    set-data: func(dimension: string, x: s32, y: s32, z: s32, data: list<u8>) -> result<_, string>;
    /// Every position in `dimension` where the mod keeps data (some may be
    /// stale until read: `get-data` says), for a tick over its machines.
    data-positions: func(dimension: string) -> list<tuple<s32, s32, s32>>;
    /// Calls `block-events.block-tick` for this mod at a position after
    /// `delay` server ticks (1 to 72000), as long as the same block is there
    /// then: a machine's timer, a growing crop. Saved with the world. Err
    /// where no chunk is loaded, or past 65536 waiting per mod.
    schedule-tick: func(dimension: string, x: s32, y: s32, z: s32, delay: u32) -> result<_, string>;
    /// The strongest redstone signal reaching the block at a position from
    /// its neighbours (0 to 15, `getBestNeighborSignal`), as of the tick's
    /// start. Known for blocks a server mod keeps data or a storage on; none
    /// elsewhere.
    redstone-power: func(dimension: string, x: s32, y: s32, z: s32) -> option<u8>;
    /// The block at a position gives this weak redstone signal (0 to 15) on
    /// every side: wires, lamps and pistons beside it hear it from the next
    /// tick. Saved with the world, gone with the block; 0 stops it. Works in
    /// the level the server ticks last.
    set-redstone-output: func(dimension: string, x: s32, y: s32, z: s32, signal: u8) -> result<_, string>;
    /// What a comparator reads from the block at a position (0 to 15), as a
    /// chest's fill level: saved and gone as `set-redstone-output`.
    set-comparator-output: func(dimension: string, x: s32, y: s32, z: s32, signal: u8) -> result<_, string>;
    /// The mod's own bytes saved with this world under `key`, as `set-saved`
    /// left them: what a world has learned or owns, unlike `storage`, which
    /// is the same in every world. Each mod sees only its own. Worlds lend
    /// these after `init`: read them from the first tick on.
    get-saved: func(key: string) -> option<list<u8>>;
    /// Keeps `data` (up to 1 MiB) under `key` (up to 64 keys per mod) in this
    /// world's save. Empty `data` removes it.
    set-saved: func(key: string, data: list<u8>) -> result<_, string>;
    /// Whether a mod with this id is running: for optional links between
    /// mods (NeoForge's `ModList.isLoaded`). Known from the first tick on.
    mod-loaded: func(id: string) -> bool;
    /// Leaves a message for a running mod, which reads it with `mod-receive`.
    /// Up to 64 KiB each, and 1024 waiting per mod.
    mod-send: func(target: string, channel: string, data: list<u8>) -> result<_, string>;
    /// The messages waiting for this mod, oldest first, as (sender, channel,
    /// data). They are not saved.
    mod-receive: func() -> list<tuple<string, string, list<u8>>>;
    /// Whether an item is in an item tag: `c:ingots`, `minecraft:logs`.
    item-has-tag: func(item: string, tag: string) -> bool;
    /// Whether a block is in a block tag: `minecraft:mineable/pickaxe`.
    block-has-tag: func(block: string, tag: string) -> bool;
    /// Whether an entity type is in an entity type tag: `minecraft:undead`.
    entity-has-tag: func(kind: string, tag: string) -> bool;
    /// Items no crafting grid makes while this list stands (per mod, the
    /// last call wins; everyone's lists add up), for mods that open recipes by
    /// progress. Vanilla's and other mods' recipes alike; at most 4096.
    set-locked-results: func(items: list<string>) -> result<_, string>;

    /// Block states at many positions at once, in order: cheaper than asking
    /// one by one. None where no chunk is loaded. At most 4096.
    get-blocks: func(dimension: string, positions: list<tuple<s32, s32, s32>>) -> result<list<option<string>>, string>;
    /// Whether the chunk holding this column is loaded.
    is-loaded: func(dimension: string, x: s32, z: s32) -> bool;
    /// Whether the block is air of any kind; false where no chunk is loaded.
    is-air: func(dimension: string, x: s32, y: s32, z: s32) -> bool;
    /// The block's id without its properties: `minecraft:oak_log`.
    block-id: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// One property of the block's state: `axis` of an oak log gives `y`.
    block-property: func(dimension: string, x: s32, y: s32, z: s32, name: string) -> option<string>;
    /// `set-blocks` for one block.
    set-block: func(dimension: string, x: s32, y: s32, z: s32, state: string) -> result<_, string>;
    /// Changes one property of the block's state, keeping the others.
    set-block-property: func(dimension: string, x: s32, y: s32, z: s32, name: string, value: string) -> result<_, string>;
    /// Removes a block as `/setblock ... destroy` does, with its drops and
    /// particles when `drop`, or quietly.
    break-block: func(dimension: string, x: s32, y: s32, z: s32, drop: bool) -> result<_, string>;
    /// Sets every block of a box, corners included: at most 4096.
    fill: func(dimension: string, x1: s32, y1: s32, z1: s32, x2: s32, y2: s32, z2: s32, state: string) -> result<_, string>;
    /// Positions in a box holding `block` (an id, or a full state), up to
    /// `limit` (at most 4096). A box of up to 65536 blocks.
    find-blocks: func(dimension: string, x1: s32, y1: s32, z1: s32, x2: s32, y2: s32, z2: s32, block: string, limit: u32) -> result<list<tuple<s32, s32, s32>>, string>;
    /// How many blocks of a box hold `block`. A box of up to 65536 blocks.
    count-blocks: func(dimension: string, x1: s32, y1: s32, z1: s32, x2: s32, y2: s32, z2: s32, block: string) -> result<u32, string>;
    /// The y of the highest block that isn't air in a column.
    height-at: func(dimension: string, x: s32, z: s32) -> option<s32>;
    /// Ticks the world has run, as of the tick's start.
    game-time: func() -> option<u64>;
    /// The time of day (0 to 24000 is one day, and it goes on counting).
    day-time: func() -> option<u64>;
    /// `/time set`.
    set-time: func(ticks: u32) -> result<_, string>;
    /// `/weather`: `clear`, `rain` or `thunder` for `seconds` (at least 1).
    set-weather: func(weather: string, seconds: u32) -> result<_, string>;
    /// `/gamerule`: `keep_inventory`, `true`.
    set-gamerule: func(rule: string, value: string) -> result<_, string>;
    /// `/difficulty`: `peaceful`, `easy`, `normal` or `hard`.
    set-difficulty: func(difficulty: string) -> result<_, string>;
    /// `/setworldspawn`.
    set-world-spawn: func(x: s32, y: s32, z: s32) -> result<_, string>;
    /// Strikes lightning at a position.
    lightning: func(dimension: string, x: f64, y: f64, z: f64) -> result<_, string>;
    /// An explosion of `power` (a creeper's is 3, TNT's 4), at most 16, as
    /// game rules allow, asked of `game-events.explosion`.
    explode: func(dimension: string, x: f64, y: f64, z: f64, power: f32) -> result<_, string>;
    /// Whether the mod keeps data on this block.
    has-data: func(dimension: string, x: s32, y: s32, z: s32) -> bool;
    /// The keys this mod has under `set-saved`.
    saved-keys: func() -> list<string>;
    /// The ids of the running mods.
    running-mods: func() -> list<string>;
    /// Whether a string names a block state: check before storing one.
    is-valid-state: func(state: string) -> bool;
    /// Whether the game knows this item.
    item-exists: func(item: string) -> bool;
    /// An item's stack size; none for an item the game doesn't know.
    max-stack-size: func(item: string) -> option<u32>;
    /// A random number, different on each call (the sandbox has no clock to seed one from).
    random-u32: func() -> u32;
}

/// Capability `world`: items, energy and fluids kept on blocks, which every
/// server mod can move in and out (a pipe of one mod feeds a machine of
/// another), and windows with slots for them. A storage belongs to the mod
/// that declared it, lives on its block like `world.set-data` (saved with
/// the world, gone with the block) and works in every dimension. Vanilla
/// containers (chests, barrels, hoppers, furnaces, shulker boxes...) answer
/// the item calls too, in the loaded level.
interface storages {
    use players.{item-stack};

    /// A fluid amount in millibuckets (1000 per bucket).
    record fluid-stack {
        /// `minecraft:water`, `minecraft:lava`, or any id a mod uses.
        fluid: string,
        amount: u32,
    }
    /// What a storage holds: slots (up to 54), energy (FE, the unit
    /// NeoForge mods use) and tanks (up to 16), each with its capacity in mB.
    record storage-shape {
        slots: u32,
        energy-capacity: u64,
        tanks: list<u32>,
    }
    /// Gives the block at a position a storage of this shape, for this mod.
    /// Declared again with another shape it keeps what fits. Err where no
    /// chunk is loaded, on air, on another mod's storage or a vanilla
    /// container, or past 65536 storages per mod.
    declare: func(dimension: string, x: s32, y: s32, z: s32, shape: storage-shape) -> result<_, string>;
    /// Removes this mod's storage there, and what it held.
    remove: func(dimension: string, x: s32, y: s32, z: s32);
    /// The storage's shape there (a vanilla container: its slots only).
    shape: func(dimension: string, x: s32, y: s32, z: s32) -> option<storage-shape>;

    /// The slots of the storage or vanilla container there.
    items: func(dimension: string, x: s32, y: s32, z: s32) -> option<list<option<item-stack>>>;
    /// Sets a slot of the mod's own storage (no limits but the slot count).
    set-item: func(dimension: string, x: s32, y: s32, z: s32, slot: u32, stack: option<item-stack>) -> result<_, string>;
    /// Moves a stack in, as a hopper does: into slots holding the same item
    /// first, then empty ones, up to each item's stack size. How many went in
    /// (or would, when `simulate`).
    insert-item: func(dimension: string, x: s32, y: s32, z: s32, stack: item-stack, simulate: bool) -> u32;
    /// Takes up to `count` from the first slot holding `item` (none: any
    /// item), as a hopper does. What came out (or would).
    extract-item: func(dimension: string, x: s32, y: s32, z: s32, item: option<string>, count: u32, simulate: bool) -> option<item-stack>;

    /// Stored and capacity, in FE.
    energy: func(dimension: string, x: s32, y: s32, z: s32) -> option<tuple<u64, u64>>;
    /// How much went in (up to the capacity), or would.
    insert-energy: func(dimension: string, x: s32, y: s32, z: s32, amount: u64, simulate: bool) -> u64;
    /// How much came out, or would.
    extract-energy: func(dimension: string, x: s32, y: s32, z: s32, amount: u64, simulate: bool) -> u64;
    /// Sets the mod's own storage's energy (clamped to its capacity).
    set-energy: func(dimension: string, x: s32, y: s32, z: s32, amount: u64) -> result<_, string>;

    /// Each tank's fluid, none when empty.
    fluids: func(dimension: string, x: s32, y: s32, z: s32) -> option<list<option<fluid-stack>>>;
    /// Fills tanks holding the same fluid first, then empty ones: how many mB went in, or would.
    insert-fluid: func(dimension: string, x: s32, y: s32, z: s32, fluid: fluid-stack, simulate: bool) -> u32;
    /// Drains up to `amount` mB from the first tank holding `fluid` (none: any).
    extract-fluid: func(dimension: string, x: s32, y: s32, z: s32, fluid: option<string>, amount: u32, simulate: bool) -> option<fluid-stack>;
    /// Sets a tank of the mod's own storage (clamped to its capacity).
    set-fluid: func(dimension: string, x: s32, y: s32, z: s32, tank: u32, fluid: option<fluid-stack>) -> result<_, string>;

    /// Opens a window with the storage's slots and the player's inventory,
    /// as a chest's: the server runs every click, shift-click and drag, so
    /// the mod only reads its slots. The window has rows of 9 (a storage of
    /// 9, 18, ... 54 slots) or is a hopper's (5 slots); `title` is plain
    /// text. It closes when the player leaves or the storage goes. Err for
    /// another shape, or a player not online.
    open-menu: func(player: string, dimension: string, x: s32, y: s32, z: s32, title: string) -> result<_, string>;
    /// `open-menu` with the window chosen by name: `minecraft:generic_9x1` to
    /// `generic_9x6`, `generic_3x3`, `shulker_box` (27 slots), `hopper` (5),
    /// `furnace`, `blast_furnace`, `smoker` (3). Err when the storage's slots
    /// don't fit it, or for another name.
    open-menu-as: func(player: string, dimension: string, x: s32, y: s32, z: s32, title: string, kind: string) -> result<_, string>;
    /// A storage of 3 slots opens as a furnace's window (input, fuel,
    /// output); these are its bars: flame left, flame total, arrow progress,
    /// arrow total. Sent to whoever has the window open when they change. Err
    /// for another mod's storage or not 4 values.
    set-menu-data: func(dimension: string, x: s32, y: s32, z: s32, data: list<s16>) -> result<_, string>;
    /// What players may do with a slot of the mod's storage in a window.
    record slot-rule {
        /// Nothing goes in by hand: an output.
        take-only: bool,
        /// The only items that go in; empty: any.
        items: list<string>,
    }
    /// Sets a slot's rule; none lifts it. What a window's player puts in
    /// against it goes back to their inventory. Mods' own calls ignore rules.
    /// Err for another mod's storage or a slot it doesn't have.
    set-slot-rule: func(dimension: string, x: s32, y: s32, z: s32, slot: u32, rule: option<slot-rule>) -> result<_, string>;

    /// Whether a mod's storage is on this block (vanilla containers: no).
    has-storage: func(dimension: string, x: s32, y: s32, z: s32) -> bool;
    /// Whether the storage or vanilla container there holds nothing at all.
    is-empty: func(dimension: string, x: s32, y: s32, z: s32) -> bool;
    /// Whether every slot there holds a full stack.
    is-full: func(dimension: string, x: s32, y: s32, z: s32) -> bool;
    /// Empty slots there.
    free-slots: func(dimension: string, x: s32, y: s32, z: s32) -> u32;
    /// How many of `item` the slots there hold.
    count-item: func(dimension: string, x: s32, y: s32, z: s32, item: string) -> u32;
    /// Empties the mod's own storage: items, energy and fluids.
    clear: func(dimension: string, x: s32, y: s32, z: s32) -> result<_, string>;
    /// Every position in `dimension` of this mod's storages.
    positions: func(dimension: string) -> list<tuple<s32, s32, s32>>;
    /// How much more energy fits there, in FE.
    free-energy: func(dimension: string, x: s32, y: s32, z: s32) -> u64;
    /// How many mB of `fluid` the tanks there hold.
    fluid-amount: func(dimension: string, x: s32, y: s32, z: s32, fluid: string) -> u32;
    /// Moves up to `count` of `item` (none: any) from one block to another
    /// as a hopper would, only as much as fits: how many moved.
    transfer-item: func(dimension: string, %from: tuple<s32, s32, s32>, to: tuple<s32, s32, s32>, item: option<string>, count: u32) -> u32;
    /// Moves up to `amount` FE, only as much as fits: how much moved.
    transfer-energy: func(dimension: string, %from: tuple<s32, s32, s32>, to: tuple<s32, s32, s32>, amount: u64) -> u64;
    /// Moves up to `amount` mB of `fluid` (none: any): how many moved.
    transfer-fluid: func(dimension: string, %from: tuple<s32, s32, s32>, to: tuple<s32, s32, s32>, fluid: option<string>, amount: u32) -> u32;
}

/// Capability `entities` (server mods): the mobs of the loaded level, and
/// the server's own commands for entities, effects, particles and sounds.
/// Changes are made in order at the end of the call's tick, as the server
/// console would make them.
interface entities {
    use players.{item-stack};

    record entity {
        /// The UUID, `xxxxxxxx-xxxx-...`; a player's is `players`'s id.
        id: string,
        /// `minecraft:zombie`.
        kind: string,
        x: f64,
        y: f64,
        z: f64,
        health: f32,
    }
    /// The living mobs within `radius` (up to 128) blocks of a position, as
    /// of the tick's start, nearest first, at most 256. Mobs of the level the
    /// server ticks last (single player: the owner's) only.
    near: func(dimension: string, x: f64, y: f64, z: f64, radius: f64) -> list<entity>;
    /// `/summon`: `kind` at a position, with `nbt` (SNBT, empty for none).
    spawn: func(dimension: string, kind: string, x: f64, y: f64, z: f64, nbt: string) -> result<_, string>;
    /// `/damage`: hurts an entity or player by its id.
    hurt: func(id: string, amount: f32) -> result<_, string>;
    /// The mod's bytes on an entity (or player) by id: saved with the world,
    /// the data attachments of NeoForge. Each mod sees only its own.
    get-data: func(id: string, key: string) -> option<list<u8>>;
    /// Up to 65536 bytes, 64 keys per mod and entity; empty removes the key.
    set-data: func(id: string, key: string, data: list<u8>) -> result<_, string>;
    /// Turns a mob's own AI off (`NoAI`) or back on, so a mod can drive it.
    set-ai: func(id: string, on: bool) -> result<_, string>;
    /// The name over a mob's head; none removes it.
    set-name: func(id: string, name: option<string>) -> result<_, string>;
    /// Sets a mob's motion, in blocks per tick. A mob with its AI off doesn't
    /// move: `teleport` drives it.
    set-velocity: func(id: string, x: f64, y: f64, z: f64) -> result<_, string>;
    /// `/rotate`: which way an entity faces, in degrees: how a display mob
    /// (`"display": true` in its type) turns its moving parts.
    set-rotation: func(id: string, yaw: f32, pitch: f32) -> result<_, string>;
    /// Sends a mob walking to a position at `speed` times its own (1.0 is
    /// its walk), as a goal would. Its goals may send it elsewhere later.
    move-to: func(id: string, x: f64, y: f64, z: f64, speed: f64) -> result<_, string>;
    /// The entity a mob attacks: a mob's or player's id; none: no one.
    set-target: func(id: string, target: option<string>) -> result<_, string>;
    /// `/item replace entity`: what a mob or player wears or holds. `slot`:
    /// `weapon.mainhand`, `weapon.offhand`, `armor.head`, `armor.chest`...
    /// A stack's `data` isn't carried.
    set-equipment: func(id: string, slot: string, stack: item-stack) -> result<_, string>;
    /// Drops a stack on the ground as an item at a block, at the end of the
    /// tick (of that dimension's next turn, if it isn't in place).
    drop-item: func(dimension: string, x: s32, y: s32, z: s32, stack: item-stack) -> result<_, string>;
    /// `/attribute`: sets the base value of an attribute
    /// (`minecraft:max_health`) of an entity or player.
    set-attribute: func(id: string, attribute: string, value: f64) -> result<_, string>;
    /// `/kill`.
    kill: func(id: string) -> result<_, string>;
    /// `/tp`: to a position in a dimension.
    teleport: func(id: string, dimension: string, x: f64, y: f64, z: f64) -> result<_, string>;
    /// `/effect give`: `effect` (`minecraft:speed`) for `seconds` at
    /// `amplifier` (0 is level I).
    effect: func(id: string, effect: string, seconds: u32, amplifier: u8) -> result<_, string>;
    /// `/particle`: `count` of `particle` (`minecraft:flame`) spread over
    /// `dx dy dz`, at `speed`, seen by every player in range.
    particle: func(dimension: string, particle: string, x: f64, y: f64, z: f64, dx: f32, dy: f32, dz: f32, speed: f32, count: u32) -> result<_, string>;
    /// `/playsound`: `sound` (`minecraft:block.anvil.use`) at a position for
    /// every player in range.
    sound: func(dimension: string, sound: string, x: f64, y: f64, z: f64, volume: f32, pitch: f32) -> result<_, string>;

    /// A living mob of a dimension by its id, as of the tick's start.
    get: func(dimension: string, id: string) -> option<entity>;
    /// Whether that mob is alive there.
    exists: func(dimension: string, id: string) -> bool;
    /// `near`, only mobs of `kind`.
    of-kind: func(dimension: string, kind: string, x: f64, y: f64, z: f64, radius: f64) -> list<entity>;
    /// The nearest mob within `radius`, of `kind` if given.
    nearest: func(dimension: string, x: f64, y: f64, z: f64, radius: f64, kind: option<string>) -> option<entity>;
    /// How many mobs are within `radius` (up to 128).
    count-near: func(dimension: string, x: f64, y: f64, z: f64, radius: f64) -> u32;
    /// `/effect clear`: every effect of an entity or player.
    clear-effects: func(id: string) -> result<_, string>;
    /// `/effect clear`: one effect of an entity or player.
    remove-effect: func(id: string, effect: string) -> result<_, string>;
    /// Heals a mob, up to its maximum health.
    heal: func(id: string, amount: f32) -> result<_, string>;
    /// Sets a mob's health, from above 0 up to its maximum.
    set-health: func(id: string, health: f32) -> result<_, string>;
    /// `/swing`: an entity or player swings its main hand.
    swing: func(id: string) -> result<_, string>;
}

/// Capability `worldgen`, server mods only (experimental): world generation
/// modifiers. Today one surface block per biome, applied to the chunks the
/// game decorates while the rule is set.
interface worldgen {
    /// The block the game puts at the top of `biome`'s terrain, e.g.
    /// `minecraft:stone`. The last rule for a biome wins.
    set-surface-rule: func(biome: string, surface: string) -> result<_, string>;
    /// A vein of ore, in the chunks the game decorates while it is set.
    record ore {
        /// `minecraft:plains`, or `*` for every biome.
        biome: string,
        /// What the vein is made of.
        block: string,
        /// What it may replace (`minecraft:stone`, ...).
        replaces: list<string>,
        min-y: s32,
        max-y: s32,
        /// Blocks in a vein, 1 to 64.
        size: u32,
        /// Veins tried per chunk, 1 to 64.
        per-chunk: u32,
    }
    /// Adds veins of ore to new chunks. A mod may add up to 64.
    add-ore: func(ore: ore) -> result<_, string>;
}

/// What the server calls in a server mod (manifest `api = "0.3"`,
/// experimental). Only the hooks `init` asks for are ever called. The player
/// in each event is as the server saw them when it happened.
interface server-events {
    use players.{player};

    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }
    /// What an argument of a command takes. The server sends each command
    /// and its arguments to players' games, whose chat box completes and
    /// colours them as vanilla's; the server parses them before the mod's
    /// `command` hook gets their values.
    variant argument-kind {
        /// One word: letters, digits and `_ - . +`.
        word,
        /// The rest of the line, spaces included: only last.
        text,
        /// A whole number, within the bounds given.
        integer(tuple<option<s32>, option<s32>>),
        /// A number with or without decimals.
        number,
        /// `true` or `false`.
        boolean,
        /// One online player: a name, or `@s` or `@p` (whoever typed it,
        /// as vanilla picks for a player).
        player,
        /// A block position: three whole numbers, each one also `~` or
        /// `~n`, relative to whoever typed it.
        block-pos,
    }
    record argument {
        /// Shown in the chat box's hint (`<height>`) and the key of its value.
        name: string,
        kind: argument-kind,
        /// Optional arguments come after every required one.
        optional: bool,
    }
    record server-command {
        /// Without the slash. A name vanilla already uses is refused
        /// (vanilla's command runs).
        name: string,
        /// In order; none: the command takes nothing after its name. Free
        /// text is one optional `text` argument.
        arguments: list<argument>,
    }
    /// An argument's value, parsed as its kind says.
    variant argument-value {
        word(string),
        text(string),
        integer(s32),
        number(f64),
        boolean(bool),
        player(player),
        block-pos(block-pos),
    }
    record registration {
        /// Commands players may type.
        commands: list<server-command>,
        /// Call `tick` every server tick (20 per second).
        tick: bool,
        /// Call `player-joined` and `player-left`.
        joins: bool,
        /// Call `chat` for each chat message a player sends.
        chat: bool,
        /// Call `block-broken` and `block-placed`.
        blocks: bool,
    }
    /// Once, after loading. An error keeps the mod off and is logged.
    init: func() -> result<registration, string>;
    /// Each server tick, with the server's tick counter.
    tick: func(tick: u64);
    /// A player joined the server; they are in `players.online` already.
    player-joined: func(player: player);
    /// A player left the server; they are no longer in `players.online`.
    player-left: func(player: player);
    /// A chat message a player sent, as plain text.
    chat: func(player: player, text: string);
    /// `/name args` typed by `player`: ok(some(text)) is their feedback,
    /// err(text) their error in red. `values` holds each argument given, by
    /// name, in order (an optional one left out isn't there); a line that
    /// doesn't parse never reaches the mod: the player gets vanilla's error.
    command: func(player: player, name: string, args: string, values: list<tuple<string, argument-value>>) -> result<option<string>, string>;
    /// A player broke the block at `pos` in their dimension: `state` is what
    /// was there, as `minecraft:oak_log[axis=y]`.
    block-broken: func(player: player, pos: block-pos, state: string);
    /// A player placed `state` at `pos` in their dimension.
    block-placed: func(player: player, pos: block-pos, state: string);
}

/// Capability `world` for a server mod: loot tables, rolled as the game
/// rolls them. `seed` makes a roll repeat; `none` rolls a fresh one. A roll
/// sees no position, luck or killer beyond what the function takes, so a
/// table's conditions on them fail, as `/loot` with no source.
interface loot {
    use players.{item-stack};

    /// What `table` (`minecraft:chests/simple_dungeon`) gives. Err for a
    /// table the game doesn't have.
    roll: func(table: string, seed: option<u64>) -> result<list<item-stack>, string>;
    /// Whether the game has `table`, a mod's own (`data/<id>/loot_table/`)
    /// included.
    table-exists: func(table: string) -> bool;
    /// What breaking `state` (`minecraft:oak_leaves`) with `tool` would drop
    /// (`none`: by hand). Err for a state the game doesn't have.
    block-drops: func(state: string, tool: option<item-stack>, seed: option<u64>) -> result<list<item-stack>, string>;
    /// What a mob of `kind` (`minecraft:zombie`) would drop, killed by a
    /// player when `by-player` is set. Err for a kind with no table.
    entity-drops: func(kind: string, by-player: bool, seed: option<u64>) -> result<list<item-stack>, string>;
    /// Rolls `table` into `player`'s inventory, at the tick's end (what
    /// doesn't fit drops at their feet): the stacks rolled. Err for an
    /// unknown table or a player not online.
    give: func(player: string, table: string, seed: option<u64>) -> result<list<item-stack>, string>;
    /// Rolls `table` onto the ground at x y z, at the tick's end: the
    /// stacks rolled.
    drop: func(dimension: string, x: s32, y: s32, z: s32, table: string, seed: option<u64>) -> result<list<item-stack>, string>;
    /// Empties the vanilla container at x y z (a chest, barrel, hopper...)
    /// and rolls `table` into it, stacks in random slots as a chest's loot
    /// is laid out: how many stacks went in (those past its slots are lost,
    /// as in vanilla). Err for no container there or an unknown table.
    fill-container: func(dimension: string, x: s32, y: s32, z: s32, table: string, seed: option<u64>) -> result<u32, string>;
}

/// Capability `world` for a server mod: the recipes the server has. An id
/// is `minecraft:oak_planks`, a mod's `<id>:<file name>`; a type is the
/// recipe file's, `minecraft:crafting_shaped`, `minecraft:smelting`,
/// `minecraft:stonecutting`...
interface recipes-server {
    use players.{item-stack};

    /// Every crafting, cooking and stonecutting recipe.
    all: func() -> list<string>;
    /// The recipes of `kind`; crafting recipes with code of their own
    /// (banner copying, map cloning...) are `minecraft:crafting_special`.
    by-type: func(kind: string) -> list<string>;
    /// The recipes that make `item`.
    by-result: func(item: string) -> list<string>;
    /// The recipes that take `item` (a tag in a recipe counts each item in
    /// it).
    by-ingredient: func(item: string) -> list<string>;
    /// A recipe's file, as JSON; `none` for an unknown one.
    get: func(id: string) -> option<string>;
    /// What a crafting grid of 4 (2 x 2) or 9 (3 x 3) cells, row by row,
    /// makes, and which recipe; `none` for nothing, or another size.
    match-crafting: func(grid: list<option<item-stack>>) -> option<tuple<string, item-stack>>;
    /// What a furnace makes of `stack`, and which recipe.
    match-smelting: func(stack: item-stack) -> option<tuple<string, item-stack>>;
    /// What a stonecutter offers for `stack`: each recipe and its result.
    match-stonecutting: func(stack: item-stack) -> list<tuple<string, item-stack>>;
    /// How many ticks a furnace takes to smelt `stack`.
    smelting-time: func(stack: item-stack) -> option<u32>;
    /// The experience smelting `stack` gives.
    smelting-xp: func(stack: item-stack) -> option<f32>;
    /// The recipe files of a type of this mod's own (`<id>:grinding`), from
    /// `data/*/recipe/` of every content namespace: each id and its JSON,
    /// for the mod's own machine to read. Empty for a type of another
    /// namespace's: a mod reads its own types.
    of-own-type: func(kind: string) -> list<tuple<string, string>>;
}

/// Capability `world` for a server mod: item types and stacks as the game
/// knows them. A stack in is a `players.item-stack`; a stack out is a new
/// one, the one handed in unchanged. Reads during a `before-events` hook
/// inside a mob's tick answer nothing (the world isn't lent there).
interface items {
    use players.{item-stack};

    /// What eating an item gives.
    record food {
        nutrition: u32,
        saturation: f32,
        /// Eaten with a full hunger bar too (golden apples).
        can-always-eat: bool,
    }
    /// An attribute modifier on a stack, as `/attribute` names them.
    record modifier {
        /// `minecraft:attack_damage`.
        attribute: string,
        /// The modifier's own id, `mymod:sharp_edge`.
        id: string,
        amount: f64,
        /// `add_value`, `add_multiplied_base` or `add_multiplied_total`.
        operation: string,
        /// `mainhand`, `offhand`, `hand`, `head`, `chest`, `legs`, `feet`,
        /// `armor`, `body` or `any`.
        slot: string,
    }
    /// An effect a potion gives.
    record potion-effect {
        effect: string,
        duration: s32,
        amplifier: u8,
    }

    /// Every item id the game has, mods' included, in registry order.
    all: func() -> list<string>;
    /// Every item in `tag` (`minecraft:logs`, with or without `#`); `none`
    /// for a tag the game doesn't have.
    exists-in-tag: func(tag: string) -> option<list<string>>;
    /// An item's name in the server's language (English on a dedicated
    /// server); `none` for an unknown item.
    name: func(item: string) -> option<string>;
    /// How many uses it has before it breaks: 0 for one that doesn't wear.
    max-damage: func(item: string) -> option<u32>;
    /// Whether it wears with use (a `max-damage` above 0).
    is-damageable: func(item: string) -> bool;
    /// Whether it can be eaten.
    is-food: func(item: string) -> bool;
    /// What eating it gives; `none` for an item that isn't food.
    food-values: func(item: string) -> option<food>;
    /// Whether it places a block when used on one.
    is-block-item: func(item: string) -> bool;
    /// The block it places, `minecraft:oak_planks`.
    block-of: func(item: string) -> option<string>;
    /// How many ticks it burns in a furnace: 0 for no fuel.
    fuel-ticks: func(item: string) -> u32;
    /// `common`, `uncommon`, `rare` or `epic`, as the item comes.
    rarity: func(item: string) -> option<string>;

    /// The stack's components as SNBT, `{"minecraft:damage":3,...}`: `{}`
    /// for a plain stack. Its count is left out; the mod's own bytes are
    /// under `minecraft:custom_data`, like the other mods'.
    components: func(stack: item-stack) -> result<string, string>;
    /// One component (`minecraft:lore`) as SNBT; `none` when it isn't set.
    get-component: func(stack: item-stack, name: string) -> option<string>;
    /// The stack with component `name` set to `value` (SNBT, as `/give`
    /// takes it: `minecraft:damage`, `5`). Err for a value the game can't
    /// read.
    set-component: func(stack: item-stack, name: string, value: string) -> result<item-stack, string>;
    /// The stack without component `name` (its item's default comes back).
    remove-component: func(stack: item-stack, name: string) -> result<item-stack, string>;
    /// How worn it is: 0 for new.
    get-damage: func(stack: item-stack) -> u32;
    /// The stack worn to `damage`, at most its item's `max-damage`. Err for
    /// an item that doesn't wear.
    set-damage: func(stack: item-stack, damage: u32) -> result<item-stack, string>;
    /// The stack `amount` uses less worn, at most new.
    repair: func(stack: item-stack, amount: u32) -> result<item-stack, string>;
    /// The name an anvil or a mod gave it.
    get-custom-name: func(stack: item-stack) -> option<string>;
    /// Its lore lines, as plain text.
    get-lore: func(stack: item-stack) -> list<string>;
    /// Whether both are the same item, whatever their components.
    same-item: func(a: item-stack, b: item-stack) -> bool;
    /// Whether `b` would go onto `a`: the same item and components, and room
    /// left under the item's stack size.
    can-stack: func(a: item-stack, b: item-stack) -> bool;
    /// `count` taken off: the part taken and what's left (count 0 when
    /// nothing is).
    split: func(stack: item-stack, count: u32) -> tuple<item-stack, item-stack>;
    /// The stack with `by` more (or fewer) items, between 0 and its item's
    /// stack size.
    grow: func(stack: item-stack, by: s32) -> item-stack;
    /// Its enchantments and their levels (a book's stored ones included).
    enchantments: func(stack: item-stack) -> list<tuple<string, u32>>;
    /// One enchantment's level: 0 when it hasn't it.
    enchantment-level: func(stack: item-stack, enchantment: string) -> u32;
    /// The stack with `enchantment` at `level` (1 to 255), whether or not
    /// the item takes it, as `/enchant` would not: a book stores it. Err for
    /// an enchantment the game doesn't have.
    set-enchantment: func(stack: item-stack, enchantment: string, level: u32) -> result<item-stack, string>;
    /// The stack without `enchantment` (a book's stored one too).
    remove-enchantment: func(stack: item-stack, enchantment: string) -> result<item-stack, string>;
    /// Whether it shines: enchanted, glinting by nature, or told to.
    has-glint: func(stack: item-stack) -> bool;
    /// Its attribute modifiers: the stack's own, else its item's.
    attribute-modifiers: func(stack: item-stack) -> list<modifier>;
    /// The stack with `modifier` beside the others (one of the same id
    /// replaced). Err for an unknown operation or slot.
    add-attribute-modifier: func(stack: item-stack, modifier: modifier) -> result<item-stack, string>;
    /// How fast `tool` breaks `block`: 1 for a hand's speed.
    tool-speed: func(tool: item-stack, block: string) -> f32;
    /// Whether `tool` gets `block`'s drops.
    is-correct-tool: func(tool: item-stack, block: string) -> bool;
    /// Its dye colour as RGB (leather armour).
    dyed-color: func(stack: item-stack) -> option<u32>;
    /// The stack dyed `color` (RGB), or undyed with `none`.
    set-dyed-color: func(stack: item-stack, color: option<u32>) -> result<item-stack, string>;
    /// A potion's, a tipped arrow's or a lingering potion's potion
    /// (`minecraft:swiftness`) and the effects it gives.
    potion-contents: func(stack: item-stack) -> option<tuple<string, list<potion-effect>>>;
    /// The stack as `potion` (`none`: water). Horizon keeps a potion's base
    /// only, not effects of its own. Err for a potion the game doesn't have.
    set-potion-contents: func(stack: item-stack, potion: option<string>) -> result<item-stack, string>;
    /// What a shulker box or a bundle holds.
    container-contents: func(stack: item-stack) -> list<item-stack>;
}

/// Capability `world` for a server mod: the dimensions the server has.
interface dimensions {
    use players.{player};

    /// Every dimension, `minecraft:overworld` first, then the mods' own.
    %list: func() -> list<string>;
    /// Whether the server has `dimension`.
    exists: func(dimension: string) -> bool;
    /// Whether it is open now: a player there, or kept for a mod's machines.
    loaded: func(dimension: string) -> bool;
    /// The vanilla dimension a mod's is made over (its own for a vanilla
    /// one); `none` for an unknown one.
    base: func(dimension: string) -> option<string>;
    /// Its lowest block's y.
    min-y: func(dimension: string) -> option<s32>;
    /// Its highest block's y.
    max-y: func(dimension: string) -> option<s32>;
    /// The players in it now.
    players-in: func(dimension: string) -> list<player>;
}

/// Asked before the server acts on a block: what a server mod answers
/// decides it (manifest `api = "0.3"`, the mod's registration has
/// `blocks`). A server mod built before this interface has no such export
/// and is not asked. The block hasn't changed yet when the mod is asked.
interface block-events {
    use players.{player, item-stack};

    /// `player` starts breaking the block at `x y z` in their dimension;
    /// `state` is what is there, as `minecraft:oak_log[axis=y]`. True refuses
    /// it: the block stays, and the player's game puts it back, as under
    /// spawn protection. Every mod asked may refuse.
    break-block: func(player: player, x: s32, y: s32, z: s32, state: string) -> bool;
    /// `player` right-clicks the block at `x y z` (`state`) holding `item`
    /// in the hand they use (`minecraft:air`: an empty hand). True: the mod
    /// handled it, and vanilla neither uses the block (doors, chests,
    /// buttons...) nor uses or places the held item there. The first mod (in
    /// load order) that answers true takes it.
    use-block: func(player: player, x: s32, y: s32, z: s32, state: string, item: string) -> bool;
    /// `player` is about to place `item` (a block item) at `x y z`, the
    /// block it would go in. True refuses it: nothing is placed and the item
    /// stays. Every mod asked may refuse.
    place-block: func(player: player, x: s32, y: s32, z: s32, item: string) -> bool;
    /// `player` right-clicks the air holding `stack` (`off-hand`: in the off
    /// hand). True: the mod handled it and vanilla does not use the item.
    use-item: func(player: player, stack: item-stack, off-hand: bool) -> bool;
    /// The tick `world.schedule-tick` asked for, the block still `state`.
    block-tick: func(dimension: string, x: s32, y: s32, z: s32, state: string);
    /// A block next to one this mod keeps data or a storage on changed,
    /// found at the tick's start: `state` is the mod's block, `from-*` the
    /// neighbour.
    neighbor-changed: func(dimension: string, x: s32, y: s32, z: s32, state: string, from-x: s32, from-y: s32, from-z: s32);
}

/// What happens to entities and the world, for server mods that list the
/// event in their manifest (`events = ["entity-hurt", ...]`). Mods are
/// asked in order of their manifest `priority` (higher first, then load
/// order); for an event that can be cancelled, the first mod that answers
/// true cancels it and the mods after it are not asked. Every event but
/// `explosion` is found at the end of the server tick it happened in, in the
/// level ticked last (single player: the owner's), so a cancel undoes it
/// there: a spawned mob is removed, a hurt mob gets its health back. A server
/// mod built before this interface has no such export and is not asked.
interface game-events {
    use players.{player, item-stack};
    use entities.{entity};

    /// A mob appeared (natural spawn, egg, breeding, `/summon`, another
    /// mod). True removes it.
    entity-spawned: func(dimension: string, entity: entity) -> bool;
    /// A mob lost `amount` health this tick and lives. True gives it back.
    entity-hurt: func(dimension: string, entity: entity, amount: f32) -> bool;
    /// A mob died; `killer` is the player who last hurt it, if one did.
    entity-died: func(dimension: string, entity: entity, killer: option<string>);
    /// A player lost `amount` health this tick.
    player-hurt: func(player: player, amount: f32);
    /// A player picked up `stack` from the ground.
    item-picked-up: func(player: player, stack: item-stack);
    /// An explosion of `power` (TNT: 4) is about to go off: true stops it,
    /// with no damage and no blocks broken. Asked as it happens.
    explosion: func(dimension: string, x: f64, y: f64, z: f64, power: f32) -> bool;
}

/// The game's side of `game-events`.
world events-host {
    export game-events;
}

/// Asked before something happens, as it happens, of the server mods whose
/// manifest lists the event with `before-` in front (`events =
/// ["before-entity-hurt", ...]`), in order of `priority`. A hook that refuses
/// stops the asking: the mods after it are not asked. A hook that changes a
/// value hands the changed value to the next mod. What a mod does from here
/// (`entities`, `world`...) waits for the tick's end, as always.
interface before-events {
    use players.{player, item-stack};
    use entities.{entity};

    /// A mob is about to join the level in place: `reason` is `natural`,
    /// `chunk` (made with new terrain), `spawner`, `mob` (born of another:
    /// breeding, a slime splitting, a zombie's reinforcements) or `summoned`
    /// (a spawn egg, `/summon`, a raid, a patrol, an iron golem, a warden,
    /// another mod). True refuses it: the mob never appears.
    entity-spawn: func(dimension: string, entity: entity, reason: string) -> bool;
    /// A mob is about to lose `amount` health to `damage-type`
    /// (`minecraft:arrow`), past invulnerability, before armor;
    /// `attacker` is the mob's or player's id when one dealt it. The answer is
    /// what it loses instead: `amount` to leave it, 0 or less refuses the hit.
    /// Asked inside the mob's tick for fire, drowning, falls and the like:
    /// there `world` reads answer nothing, the hook sees only its arguments.
    /// Not asked yet for `/damage` and a conduit's attack.
    entity-hurt: func(dimension: string, entity: entity, damage-type: string, attacker: option<string>, amount: f32) -> f32;
    /// The same for a player, before armor and enchantments: the attacker
    /// is the mob behind a mob's hit, none for a player's (PvP).
    player-hurt: func(player: player, damage-type: string, attacker: option<string>, amount: f32) -> f32;
    /// A player's health is about to reach 0 (after a totem had its say):
    /// true keeps them alive on 1 health.
    player-death: func(player: player, damage-type: string) -> bool;
    /// An explosion at x y z will break `blocks`, after `game-events.explosion`
    /// let it go off: the answer is the ones that stay. Up to 4096 are
    /// asked of; the rest break.
    explosion-blocks: func(dimension: string, x: f64, y: f64, z: f64, blocks: list<tuple<s32, s32, s32>>) -> list<tuple<s32, s32, s32>>;
    /// `player` is about to pick up `stack` from the ground: true leaves it
    /// there. Asked again each tick they stand by it.
    item-pickup: func(player: player, stack: item-stack) -> bool;
    /// `player` is about to drop `stack` with the drop key (Q, or ctrl+Q for
    /// all of it): true keeps it in their inventory.
    item-toss: func(player: player, stack: item-stack) -> bool;
    /// What a dead mob is about to drop, by `killer` when a player killed
    /// it: `none` leaves it, a list is what drops instead (up to 64 stacks).
    mob-drop: func(dimension: string, entity: entity, killer: option<string>, drops: list<item-stack>) -> option<list<item-stack>>;
    /// Experience about to drop at x y z: `source` is `mob` (a dead mob's,
    /// asked after `mob-drop`). The answer is what drops.
    xp-drop: func(dimension: string, x: f64, y: f64, z: f64, source: string, amount: u32) -> u32;
    /// `player` is about to open the window of `block` at x y z (a chest,
    /// barrel, ender chest, shulker box, hopper, dispenser, dropper, furnace,
    /// brewing stand or crafter): true keeps it shut.
    container-open: func(player: player, x: s32, y: s32, z: s32, block: string) -> bool;
}
/// The game's side of `before-events`.
world before-events-host {
    export before-events;
}

/// Asked as they happen, of every server mod built since this interface: the
/// first that answers true takes it, and vanilla does nothing with it.
interface entity-events {
    use players.{player};
    use entities.{entity};

    /// A right click on an entity, holding `item` (`minecraft:air`: empty hand).
    /// A mob, a player (`minecraft:player`, id: the player's) or an object
    /// (boat, minecart, armor stand, item frame, painting; id: its network id,
    /// which `entities` calls don't take).
    use-entity: func(player: player, entity: entity, item: string) -> bool;
    /// An attack on an entity, holding `item`. As `use-entity`.
    attack-entity: func(player: player, entity: entity, item: string) -> bool;
    /// A mob's health reached 0; `killer` is the player who last hurt it. True
    /// keeps it alive on 1 health. Only for mods listing `entity-dying` in the
    /// manifest's `events`.
    entity-dying: func(dimension: string, entity: entity, killer: option<string>) -> bool;
    /// A mob type with `projectile` hit a block or, with `target`'s id, a
    /// living thing, at x y z. True keeps it flying; otherwise it is gone.
    projectile-hit: func(dimension: string, projectile: entity, target: option<string>, x: f64, y: f64, z: f64) -> bool;
}
world entity-events-host {
    export entity-events;
}

/// Code behind what a mod declares in data; each is asked only of the mod
/// whose id is the declaration's namespace.
interface logic-events {
    use entities.{entity};

    /// What a chunk holds: `blocks` index `palette` (`ns:block[a=b]`), 256 a
    /// layer, x then z in a layer, layers from `min-y` up. 0 in `palette` may
    /// be `minecraft:air`.
    record chunk-fill {
        palette: list<string>,
        min-y: s32,
        blocks: list<u16>,
        biome: option<string>,
    }
    /// A chunk of a dimension declared with `"generator": {"type": "code"}`.
    generate-chunk: func(dimension: string, x: s32, z: s32) -> option<chunk-fill>;
    /// Whether a mob may start `goal` (a name in its type's `goals`), asked
    /// every few ticks for goals above the one it runs. While one runs the
    /// mob's vanilla goals wait; drive it with `entities`.
    goal-can-use: func(goal: string, mob: entity) -> bool;
    /// A running goal's tick: false ends it.
    goal-tick: func(goal: string, mob: entity) -> bool;
    /// A goal ended or was replaced by one above it.
    goal-stop: func(goal: string, mob: entity);
    /// Each tick of a mob whose type says `"ticks": true`.
    entity-tick: func(dimension: string, entity: entity);
    /// Each tick of a mob or player under this mod's effect, level `amplifier`.
    effect-tick: func(effect: string, target: string, amplifier: u8);
}
world logic-events-host {
    export logic-events;
}

/// Capability `net` for a client mod: its own messages to the server's
/// mods, over the connection (single player's own server included). A
/// channel is `[a-z0-9_./-]`, 1 to 64 characters; mods agree on it (use the
/// mod's id in it). Each message is up to 32 KiB, 64 per call.
interface client-net {
    /// Sends `data` on `channel` to the server's mods (`server-net-events`).
    /// Err for a bad channel or too much; on a server that isn't Horizon's
    /// the message is dropped there.
    send: func(channel: string, data: list<u8>) -> result<_, string>;
}
/// What a client mod with capability `net` hears from the server's mods.
interface client-net-events {
    /// A message the server's mods sent on `channel`.
    received: func(channel: string, data: list<u8>);
}
/// Capability `net` for a server mod: messages to players' client mods.
interface server-net {
    /// Sends `data` on `channel` to one player's client mods. Err for a bad
    /// channel, too much, or a player not online.
    send: func(player: string, channel: string, data: list<u8>) -> result<_, string>;
    /// The same to every player.
    broadcast: func(channel: string, data: list<u8>) -> result<_, string>;
}
/// What a server mod with capability `net` hears from players' client mods.
interface server-net-events {
    use players.{player};
    /// A message `player`'s client mods sent on `channel`.
    received: func(player: player, channel: string, data: list<u8>);
}
/// The game's side of `client-net-events`.
world client-net-host {
    export client-net-events;
}
/// The game's side of `server-net-events`.
world server-net-host {
    export server-net-events;
}

/// A client mod: runs in the player's game.
world horizon-mod {
    import log;
    import game;
    import chat;
    import hud;
    import storage;
    import command;
    import client-net;
    export events;
}

/// A server mod (manifest `side = "server"`, `api = "0.3"`, experimental):
/// runs where the world is simulated, on the dedicated server, a LAN host
/// and single player's own server.
/// `block-events` for the server: a world of its own, so a server mod built
/// before it still instantiates as `horizon-server-mod` and is not asked.
world block-host {
    export block-events;
}

/// What the SDK builds a server mod as: `horizon-server-mod` and the block
/// hooks.
world horizon-server-block-mod {
    include horizon-server-mod;
    export block-events;
    export game-events;
    export before-events;
    export entity-events;
    export logic-events;
    export server-net-events;
}

world horizon-server-mod {
    import log;
    import storage;
    import players;
    import %world;
    import storages;
    import entities;
    import worldgen;
    import items;
    import dimensions;
    import loot;
    import recipes-server;
    import server-net;
    export server-events;
}

/// A mod with widgets (capability `ui`): the SDK builds every mod against
/// this world. Mods built for `horizon-mod` alone (no `ui-events` export)
/// still load and simply hear nothing of their widgets.
world horizon-ui-mod {
    include horizon-mod;
    import ui;
    import render;
    import input;
    import recipes;
    import browser;
    export ui-events;
    export client-net-events;
}

/// The game's side of `horizon-ui-mod` beyond `horizon-mod`.
world ui-host {
    import ui;
    export ui-events;
}

/// The game's side of capability `render` (imports only).
world render-host {
    import render;
    import input;
}

/// The game's side of capability `recipes` (imports only).
world recipes-host {
    import recipes;
    import browser;
}
